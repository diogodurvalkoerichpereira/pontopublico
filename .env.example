# Modelo de configuracao local. Copie para .env e ajuste.
# O .env e ignorado pelo git e nunca deve ser versionado.
#
# Importante: nenhuma variavel aqui pode receber o prefixo VITE_. Variaveis com
# esse prefixo sao injetadas no bundle do cliente e ficariam publicas.
#
# O projeto nao usa dotenv. As variaveis sao carregadas pelo proprio Node, com
# --env-file-if-exists, ja configurado nos scripts do package.json.

# --- Banco -------------------------------------------------------------------
# A senha precisa ser a mesma nas duas linhas: o docker-compose.yml usa
# POSTGRES_PASSWORD para criar o usuario, e a aplicacao usa DATABASE_URL.
POSTGRES_PASSWORD=troque-esta-senha
DATABASE_URL=postgres://meuponto:troque-esta-senha@127.0.0.1:5433/meu_ponto

# --- Sessao ------------------------------------------------------------------
# Minimo de 32 caracteres (src/lib/auth.server.ts). Gere um valor aleatorio com:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# --- Segundo fator (MFA/TOTP) ------------------------------------------------
# Chave dedicada que cifra o segredo TOTP em repouso (AES-256-GCM). Minimo de 32
# caracteres; ideal 32 bytes em base64 (src/lib/mfa.server.ts). Gere com:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# No deploy (Coolify) configure-a ANTES do primeiro uso do MFA. Sem ela, as
# operacoes de alto risco que exigem segundo fator falham ao verificar/cadastrar.
# Trocar a chave depois torna ilegiveis os segredos ja cadastrados (o usuario
# precisa recadastrar o MFA). Nunca use o prefixo VITE_.
MFA_ENC_KEY=

# --- Ponte de papeis legados (O0-10) -----------------------------------------
# A autorizacao migrou dos papeis legados (user_roles/rh_permissions) para o RBAC
# por tenant. Uma ponte de compatibilidade em src/lib/tenant-access.server.ts
# ainda concede permissoes a partir dos papeis legados. "on" (padrao) mantem a
# ponte; "off" a desliga, fechando a escalacao cross-tenant do admin legado. O
# RH legado ja foi reconciliado no papel rh_operador (migration O0-10), entao
# desligar nao retira acesso do RH. Antes de virar "off", confira nos logs que
# nao ha linhas com tag "LEGACY_BRIDGE_DEPENDENCY" (telemetria de quem ainda
# depende da ponte).
LEGACY_ROLE_BRIDGE=on

# --- Armazenamento de arquivos -----------------------------------------------
# Sem esta variavel o padrao e /data/storage, que no Windows resolve para a raiz
# do drive corrente. O diretorio .storage/ ja e ignorado pelo git.
STORAGE_DIR=./.storage

# --- Aplicacao ---------------------------------------------------------------
# E-mails promovidos a administrador no cadastro, separados por virgula.
ADMIN_EMAILS=admin@example.com
APP_URL=http://localhost:8080
TZ=America/Sao_Paulo

# --- Opcional ----------------------------------------------------------------
# Chave do servico de OCR. Sem ela o upload continua funcionando e apenas a
# leitura automatica do documento fica indisponivel.
# LOVABLE_API_KEY=

# Hosts extras aceitos por `npm run preview` (vite preview), separados por
# virgula. Sem valor, apenas localhost e aceito. Nao afeta `npm run dev`.
# PREVIEW_ALLOWED_HOSTS=

# Envio de e-mail (SMTP) NAO e configurado aqui: as credenciais ficam na tabela
# public.email_settings do banco. Sem uma linha la, todo envio falha com
# "SMTP nao configurado". Ver src/lib/email.server.ts.

# --- Legado do Supabase (nao preencher) --------------------------------------
# As variaveis abaixo sao lidas apenas por src/integrations/supabase/
# client.server.ts e auth-middleware.ts, que sao codigo morto herdado da geracao
# hospedada no Supabase e nao sao importados por nenhum arquivo em uso. A
# aplicacao roda sobre PostgreSQL proprio (DATABASE_URL) e o "client" do
# diretorio integrations/supabase e um shim local, nao o supabase-js. Estao
# listadas so para explicar por que aparecem no codigo; deixe-as em branco.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_PUBLISHABLE_KEY=
